# Igloo configuration
# Copy this file to .env next to the binary or in the repo root for development.

# INITIAL ADMIN ACCOUNT
# Used only on first launch when no admin user exists yet.
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# NETWORK
# PORT controls the HTTP listener for both development and binary runs.
# SESSION_COOKIE_SECURE should be true behind HTTPS and false for plain HTTP.
PORT=8080
SESSION_COOKIE_SECURE=true

# STORAGE
# DB_PATH is read on every startup because the database must be opened before app settings can be loaded.
# STATIC_DIR, LOGS_DIR, and TRANSCODE_DIR seed Settings only on the first launch
# when the database has no settings row. After that, edit them from Settings.
# DB_PATH=./db/igloo.db
# STATIC_DIR=./static
# LOGS_DIR=./logs
# TRANSCODE_DIR=./transcode

# MEDIA LIBRARY PATHS
# These seed Settings only on first launch. Set only the libraries you use.
# Each configured directory must already exist.
# MOVIES_DIR=/srv/media/movies
# SHOWS_DIR=/srv/media/shows
# MUSIC_DIR=/srv/media/music

# METADATA PROVIDERS
TMDB_API_KEY=
JELLYFIN_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# RUNTIME FEATURES
ENABLE_LOGGER=false
ENABLE_WATCHER=false
DOWNLOAD_IMAGES=false
LOG_TO_STDOUT=true

# TRANSCODING
# cpu is the portable default. apple is macOS VideoToolbox, intel is Linux QSV,
# and nvidia is Linux CUDA when the host has the required drivers and devices.
HARDWARE_ACCELERATION_DEVICE=cpu
# HLS_MAX_CPU_TRANSCODES=

# DEVELOPMENT
# DEBUG enables debug logging. make dev also sets VITE_DEV_SERVER.
# DEBUG=true
