# INITIAL ADMIN ACCOUNT
# Used at startup whenever no administrator exists. The password is required then.
# Changing these values does not reset an existing account.
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# NETWORK
# PORT controls the HTTP listener for both development and binary runs.
# SESSION_COOKIE_SECURE should be true behind HTTPS and false for plain HTTP.
PORT=8080
SESSION_COOKIE_SECURE=false

# STORAGE
# DB_PATH and LOGS_DIR are read on every startup; neither is stored in Settings.
# STATIC_DIR and TRANSCODE_DIR seed Settings only when the database has no settings row.
# After that, edit Settings-owned values from Settings.
DB_PATH=db/igloo.db
STATIC_DIR=static
LOGS_DIR=logs
TRANSCODE_DIR=transcode

# MEDIA LIBRARY PATHS
# These seed Settings only when the database has no settings row.
# Leave blank for libraries you do not use. SHOWS_DIR is a stored placeholder; TV scanning and playback are unimplemented.
# Each configured directory must already exist.
MOVIES_DIR=
SHOWS_DIR=
MUSIC_DIR=

# METADATA AND FEATURES
# These seed Settings only when the database has no settings row.
# TMDB and Spotify enrichment are optional; leave their credentials blank to disable them.
# JELLYFIN_API_KEY is stored in Settings, but the integration is unimplemented.
# ENABLE_WATCHER is stored in Settings, but filesystem watching is unimplemented.
TMDB_API_KEY=
JELLYFIN_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_IMAGES=false
ENABLE_WATCHER=false

# TRANSCODING
# This seeds Settings only when the database has no settings row; change it in Settings afterward.
# cpu is the portable default. apple is macOS VideoToolbox, intel is Linux QSV, and nvidia is Linux CUDA when the host has the required drivers and devices.
HARDWARE_ACCELERATION_DEVICE=cpu

# STARTUP FLAGS
# These are read on every startup and are not stored in Settings.
# LOG_TO_STDOUT defaults to DEBUG when unset or blank. Explicit false keeps file logging even with DEBUG=true.
# HLS_MAX_CPU_TRANSCODES limits concurrent HLS sessions encoding video or audio, including hardware transcodes.
# Leave blank for max(1, NumCPU/4), or set a positive integer.
# HLS_MAX_SESSIONS_PER_USER caps cached plus in-flight personal HLS sessions, including remux; rooms are separate.
# Leave blank for 3, or set a positive integer.
LOG_TO_STDOUT=false
HLS_MAX_CPU_TRANSCODES=
HLS_MAX_SESSIONS_PER_USER=
DEBUG=false

# EXTERNAL MEDIA BINARIES
# Startup overrides for externalbin builds (development and backend tests) only; ignored by embedded release builds.
# Leave blank to resolve ffmpeg and ffprobe on PATH. Use matching Jellyfin builds.
# Make development/test prerequisites still require both commands on PATH, even with overrides.
IGLOO_FFMPEG_PATH=
IGLOO_FFPROBE_PATH=
