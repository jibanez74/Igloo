# Igloo — Configuration
# Copy this file to .env, fill in your values, then run:
#   docker compose up -d (by default it uses cpu for transcoding)
# Developers: place this file at the repo root. Both "make dev" and "docker compose" will read it automatically.

# INITIAL ADMIN ACCOUNT
# Used only on first launch when no admin user exists yet.
# ------------------------------------------------------------
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# NETWORK
# HOST_PORT: port exposed on the host (default: 8080)
# SESSION_COOKIE_SECURE:
#   true  when accessing Igloo over HTTPS, for example through Tailscale Serve or a reverse proxy
#   false when testing directly over plain HTTP, for example http://localhost:8080
# ------------------------------------------------------------
HOST_PORT=8080
SESSION_COOKIE_SECURE=true

# IMAGE
# IMAGE_TAG: Docker image tag to run when using compose.yaml (default: latest)

IMAGE_TAG=latest

# MEDIA LIBRARY PATHS (optional)
# These are host paths mounted read-only into the container. Change them to match your server.

MOVIES_DIR=/srv/media/movies
SHOWS_DIR=/srv/media/shows
MUSIC_DIR=/srv/media/music

# STORAGE PATHS (optional — defaults shown)
# CONFIG_DIR: database, static files, and logs
# TRANSCODE_DIR: temporary HLS transcoding workspace
# Note: these directories must be writable by UID/GID 1000 (the igloo user inside the container).

CONFIG_DIR=./config
TRANSCODE_DIR=./transcode

# METADATA PROVIDERS (all optional — leave blank to disable)
# TMDB_API_KEY: https://www.themoviedb.org/settings/api
# JELLYFIN_TOKEN: token from your Jellyfin server
# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET:
#   create an app at https://developer.spotify.com

TMDB_API_KEY=
JELLYFIN_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# RUNTIME FEATURES (all optional — default: false)
# ENABLE_LOGGER: write structured JSON logs to CONFIG_DIR/logs
# ENABLE_WATCHER: auto-rescan library when files change
# DOWNLOAD_IMAGES: automatically download artwork on scan
# LOG_TO_STDOUT: keep logs visible through docker logs

ENABLE_LOGGER=false
ENABLE_WATCHER=false
DOWNLOAD_IMAGES=false
LOG_TO_STDOUT=true

# INTEL GPU ONLY
# Required when uncommenting the Intel QSV block in compose.yaml
# Find your render GID: getent group render | cut -d: -f3

# RENDER_GROUP_ID=105

# DEVELOPER SETTINGS (ignored by Docker)
# Uncomment and set these when running "make dev" locally.

# DEBUG=true
# PORT=8080
# DB_PATH=/path/to/igloo.db
# STATIC_DIR=/path/to/static
# LOGS_DIR=/path/to/logs

# HARDWARE_ACCELERATION_DEVICE
# Docker defaults this to cpu. Set it when uncommenting a GPU block in compose.yaml.
# For "make dev", set it here to enable hardware-accelerated transcoding:
#   apple  — Apple VideoToolbox (Mac only)
#   intel  — Intel QSV (Linux)
#   nvidia — NVIDIA CUDA (Linux)
#   cpu    — software transcoding (default)
# HARDWARE_ACCELERATION_DEVICE=cpu
