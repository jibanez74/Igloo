# Copy this file to .env in the directory where you run Igloo.
# Igloo reads .env from its current working directory. Existing process
# environment variables take precedence; relative paths start from that directory.

# INITIAL ADMIN ACCOUNT
# Set a name, email, and nonempty password before the first run. Igloo creates
# this administrator whenever no admin account exists. Changing these values
# later does not update an existing account or reset its password.
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# NETWORK
# PORT is the Go server's HTTP port. The development web app uses port 3000
# and proxies API requests to PORT=8080 by default.
# Set SESSION_COOKIE_SECURE=true when accessing Igloo over HTTPS. Keep it false
# for local plain HTTP, or the browser will not send the session cookie.
PORT=8080
SESSION_COOKIE_SECURE=false

# STORAGE
# DB_PATH is the SQLite database; LOGS_DIR holds logs when file logging is on.
# Both are read on every startup. Igloo creates application storage directories
# as needed, but the process must have permission to write to them.
# STATIC_DIR stores application images/uploads; TRANSCODE_DIR holds temporary HLS
# playback files. These two paths seed Settings on first run; change them in
# Settings afterward.
DB_PATH=db/igloo.db
STATIC_DIR=static
LOGS_DIR=logs
TRANSCODE_DIR=transcode

# MEDIA LIBRARY PATHS
# Set paths to existing, readable directories containing your movies, TV shows,
# and music. Leave unused libraries blank. These paths seed Settings on first
# run; edit them in Settings → Libraries afterward. Saving a path does not start
# a scan: use Scan Library there, or restart to scan configured libraries.
MOVIES_DIR=
SHOWS_DIR=
MUSIC_DIR=

# OPTIONAL METADATA AND STORED SETTINGS
# TMDB_API_KEY enriches movies and TV shows; Spotify credentials enrich music
# and enable Spotify search. Local scanning works without either service.
# These values seed Settings on first run; change them in Settings afterward.
# JELLYFIN_API_KEY is stored, but Jellyfin integration is not implemented.
# DOWNLOAD_IMAGES stores the artwork-download preference shown in Settings.
# ENABLE_WATCHER is stored, but automatic filesystem watching is not implemented.
TMDB_API_KEY=
JELLYFIN_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_IMAGES=false
ENABLE_WATCHER=false

# TRANSCODING
# Select the preferred video encoder. cpu is the default; apple uses macOS
# VideoToolbox, intel uses Linux QSV, and nvidia uses Linux CUDA when available.
# If the chosen hardware encoder is unavailable, Igloo falls back to CPU.
# This seeds Settings on first run; change it in Settings → Playback afterward.
HARDWARE_ACCELERATION_DEVICE=cpu

# LOGGING
# These are read on every startup. DEBUG enables debug-level messages.
# LOG_TO_STDOUT=false writes logs under LOGS_DIR; true writes to the terminal.
# If LOG_TO_STDOUT is blank or unset, it follows DEBUG instead. The explicit
# false below keeps file logging even if you set DEBUG=true.
DEBUG=false
LOG_TO_STDOUT=false

# HLS SESSION LIMITS
# These are read on every startup. Set a positive integer, or leave blank for
# the default. CPU and hardware limits count sessions encoding video in each
# pool; sessions that copy video count against neither pool.
# HLS_MAX_CPU_TRANSCODES defaults to max(1, CPU count / 4).
# HLS_MAX_HW_TRANSCODES defaults to 3.
# HLS_MAX_SESSIONS_PER_USER defaults to 3 and includes personal remux sessions;
# watch rooms have separate sessions.
HLS_MAX_CPU_TRANSCODES=
HLS_MAX_HW_TRANSCODES=
HLS_MAX_SESSIONS_PER_USER=

# EXTERNAL MEDIA BINARIES
# Development and backend tests use external ffmpeg/ffprobe. Leave these blank
# to find them on PATH, or set paths to matching executables. Make still requires
# both commands on PATH even when overrides are set. Production builds embed
# their own tools and ignore these overrides.
IGLOO_FFMPEG_PATH=
IGLOO_FFPROBE_PATH=
