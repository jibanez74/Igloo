# INITIAL ADMIN ACCOUNT
# Used only on first launch when no admin user exists yet. The password is required.
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# NETWORK
# PORT controls the HTTP listener for both development and binary runs.
# SESSION_COOKIE_SECURE should be true behind HTTPS and false for plain HTTP.
PORT=8080
SESSION_COOKIE_SECURE=false

# STORAGE
# DB_PATH is read on every startup because the database must be opened before app settings can be loaded.
# STATIC_DIR, LOGS_DIR, and TRANSCODE_DIR seed Settings only on the first launch when the database has no settings row. After that, edit them from Settings.
DB_PATH=db/igloo.db
STATIC_DIR=static
LOGS_DIR=logs
TRANSCODE_DIR=transcode

# MEDIA LIBRARY PATHS
# These seed Settings only on first launch. Leave blank for libraries you do not use.
# Each configured directory must already exist.
MOVIES_DIR=
SHOWS_DIR=
MUSIC_DIR=

# METADATA AND FEATURES
# These seed Settings only on first launch. Leave optional API keys blank to disable those integrations.
TMDB_API_KEY=
JELLYFIN_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DOWNLOAD_IMAGES=false
ENABLE_WATCHER=false

# TRANSCODING
# This seeds Settings only on first launch. cpu is the portable default. apple is macOS VideoToolbox, intel is Linux QSV, and nvidia is Linux CUDA when the host has the required drivers and devices.
HARDWARE_ACCELERATION_DEVICE=cpu

# STARTUP FLAGS
# LOG_TO_STDOUT, HLS_MAX_CPU_TRANSCODES, and DEBUG are read on every startup.
# Leave HLS_MAX_CPU_TRANSCODES blank to use the automatic CPU-based limit.
LOG_TO_STDOUT=false
HLS_MAX_CPU_TRANSCODES=
DEBUG=false
