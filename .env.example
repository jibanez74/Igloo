# Igloo — environment variable reference
# Copy this file to .env and fill in your values before running docker compose.

# media library paths (absolute paths on the host)
MOVIES_DIR=/srv/media/movies
SHOWS_DIR=/srv/media/shows
MUSIC_DIR=/srv/media/music

# Required for Intel GPU profile only -------------------------------------
# Find your render group GID with: getent group render | cut -d: -f3
RENDER_GROUP_ID=105

# Optional: storage paths (defaults shown)
# The config and transcode directories must be owned by UID/GID 1000 on the host, since the container runs as a non-root user (igloo:igloo, 1000:1000).
CONFIG_DIR=./config
TRANSCODE_DIR=./transcode
HOST_PORT=8080

# Keep true when running behind Tailscale (HTTPS). Only set false for local
# HTTP-only testing without a TLS terminator.
SESSION_COOKIE_SECURE=true

# These are only used when no admin user exists in the database yet.  Change the password immediately after first login.
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Optional: metadata providers
TMDB_API_KEY=
JELLYFIN_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Runtime feature flags
ENABLE_LOGGER=false         # write structured JSON logs to /config/logs/igloo.log
ENABLE_WATCHER=false        # watch library dirs and auto-trigger scans on changes
DOWNLOAD_IMAGES=false       # download artwork automatically during library scans
