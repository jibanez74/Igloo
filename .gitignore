# Binaries
/server/igloo-server
/server/api

# ffprobe and ffmpeg binaries (large files, distribute separately)
/server/cmd/internal/ffprobe/ffprobe_darwin_arm64
/server/cmd/internal/ffprobe/ffprobe_linux_amd64
/server/cmd/internal/ffmpeg/ffmpeg_mac_arm
/server/cmd/internal/ffmpeg/ffmpeg_linux_amd64

# IDE and editor
.idea/
.vscode/
.cursor/

  # Environment files
.env
.env.local

# Database files and directories created by app at start up
*.db
*.db-journal
*.db-shm
*.db-wal
/server/static/*

  # Embedded frontend assets (generated during build)
# These are copied from web/dist by the root Makefile
# A placeholder index.html exists for backend-only builds
/server/cmd/api/web/dist/*.html
/server/cmd/api/web/dist/assets/
/server/cmd/api/web/dist/vite.svg

# Symlink/copy of web/dist for embedding into Go binary
/server/cmd/api/webdist

# Frontend (web)
/web/node_modules/
/web/dist
/web/.tanstack/
/web/src/routeTree.gen.ts

# OS files
.DS_Store

# AU files or directories
.claude/
.codex/
AGENTS.md
CLAUDE.md

# Testing media files directory
/server/media/*
