+// The dither texture is set up once in config_props, so it is freed only
+// here: uninit_common also runs before a recompile and must not drop it.
+static av_cold void uninit_dither(AVFilterContext *ctx)
+{
+    TonemapCUDAContext *s = ctx->priv;
+
+    if (s->hwctx) {
+        CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+        CUcontext dummy, cuda_ctx = s->hwctx->cuda_ctx;
+
+        CHECK_CU(cu->cuCtxPushCurrent(cuda_ctx));
+
+        if (s->dither_tex) {
+            CHECK_CU(cu->cuTexObjectDestroy(s->dither_tex));
+            s->dither_tex = 0;
+        }
+        if (s->dither_buffer) {
+            CHECK_CU(cu->cuMemFree(s->dither_buffer));
+            s->dither_buffer = 0;
+        }
+
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    }
+}
