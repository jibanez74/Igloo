{
  "name": "igloo",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:openapi": "openapi-typescript ../docs/openapi.json --default-non-nullable false -o src/types/openapi.gen.ts",
    "check:openapi": "bun run generate:openapi && git diff --exit-code -- src/types/openapi.gen.ts",
    "lint:openapi": "redocly lint --config ../redocly.yaml ../docs/openapi.json",
    "build:openapi": "redocly build-docs --config ../redocly.yaml ../docs/openapi.json -o .openapi-docs/index.html",
    "preview:openapi": "bun run build:openapi && bun scripts/preview-openapi.mjs",
    "generate:theme": "bun scripts/generate-theme.ts",
    "generate:icons": "bun scripts/generate-icons.ts",
    "typecheck": "tsc -b",
    "build": "bun run typecheck && vite build",
    "build:analyze": "bun run typecheck && vite build --mode analyze",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:boot": "bun run build && E2E_PRODUCTION=1 playwright test e2e/boot.spec.ts",
    "preview": "vite preview",
    "doctor": "bun x react-doctor@0.9.12 --yes"
  },
  "prettier": {
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "",
      "<THIRD_PARTY_MODULES>",
      "",
      "^(@/|~/|#)",
      "^[.]"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "2.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.29.4",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "browserslist": "^4.29.4",
    "js-yaml": "4.3.2"
  }
}
