{
  "name": "igloo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:openapi": "openapi-typescript ../docs/openapi.json -o src/types/openapi.gen.ts",
    "check:openapi": "bun run generate:openapi && git diff --exit-code -- src/types/openapi.gen.ts",
    "lint:openapi": "redocly lint --config ../redocly.yaml ../docs/openapi.json",
    "build:openapi": "redocly build-docs --config ../redocly.yaml ../docs/openapi.json -o .openapi-docs/index.html",
    "preview:openapi": "bun run build:openapi && bun scripts/preview-openapi.mjs",
    "generate:theme": "bun scripts/generate-theme.ts",
    "typecheck": "tsc -b",
    "build": "bun run typecheck && vite build",
    "build:analyze": "bun run typecheck && vite build --mode analyze",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:login": "playwright test e2e/login.spec.ts",
    "test:e2e:account-settings": "playwright test e2e/account-settings.spec.ts",
    "test:e2e:device-lifecycle": "playwright test e2e/device-lifecycle.spec.ts",
    "test:e2e:general-settings": "playwright test e2e/general-settings.spec.ts",
    "test:e2e:playback-settings": "playwright test e2e/playback-settings.spec.ts",
    "test:e2e:libraries-settings": "playwright test e2e/libraries-settings.spec.ts",
    "test:e2e:user-settings": "playwright test e2e/user-settings.spec.ts",
    "test:e2e:movies": "playwright test e2e/movies.spec.ts",
    "test:e2e:movies:index": "playwright test e2e/movies-index.spec.ts",
    "test:e2e:movie-extra-videos": "playwright test e2e/movie-extra-videos.spec.ts",
    "test:e2e:movie-player": "playwright test e2e/movie-player.spec.ts",
    "test:e2e:album-details": "playwright test e2e/album-details.spec.ts",
    "test:e2e:musician-details": "playwright test e2e/musician-details.spec.ts",
    "test:e2e:hls": "playwright test e2e/hls-transcode.spec.ts",
    "test:e2e:direct-media": "playwright test e2e/direct-play-media.spec.ts",
    "test:e2e:direct-fallback": "playwright test e2e/direct-play-fallback.spec.ts",
    "test:e2e:watch-room": "playwright test e2e/watch-room.spec.ts",
    "test:e2e:quick-connect": "playwright test e2e/quick-connect.spec.ts",
    "preview": "vite preview",
    "doctor": "bun x react-doctor@0.9.12 --yes"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.17",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "2.43.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.19",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.28.7",
    "eslint": "^9.39.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "browserslist": "^4.28.4",
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
